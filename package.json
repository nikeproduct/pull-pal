{
  "name": "pull-pal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "pull-pal": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test --timeout 60000",
    "test:unit": "bun test test/unit --timeout 60000",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:coverage": "bun test --coverage --timeout 60000",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build": "bun run scripts/build.ts",
    "set-version": "bun run scripts/set-version.ts",
    "check-version": "bun run scripts/set-version.ts --check",
    "publish:npm": "bun run check-version && bun run build && bun run scripts/publish-npm.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "bun-types": "latest",
    "typescript": "^5.6.0"
  }
}
