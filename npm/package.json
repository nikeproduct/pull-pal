{
  "name": "pull-pal",
  "version": "0.2.0",
  "description": "A git push that checks your branch still merges with main and your tests pass on exactly what you push",
  "bin": {
    "pull-pal": "run.js"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "files": [
    "run.js",
    "install.js",
    "README.md"
  ],
  "optionalDependencies": {
    "@nikeproduct/pull-pal-darwin-arm64": "0.2.0",
    "@nikeproduct/pull-pal-darwin-x64": "0.2.0",
    "@nikeproduct/pull-pal-linux-x64": "0.2.0",
    "@nikeproduct/pull-pal-linux-arm64": "0.2.0",
    "@nikeproduct/pull-pal-win32-x64": "0.2.0"
  },
  "keywords": [
    "git",
    "push",
    "rebase",
    "pre-push",
    "test",
    "cli",
    "pull-pal"
  ],
  "author": "nikeproduct",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikeproduct/pull-pal.git"
  },
  "homepage": "https://github.com/nikeproduct/pull-pal#readme",
  "engines": {
    "node": ">=16"
  }
}
